      ],
      "tests": [
        {
          "path": "src/test/scala/nebflow/core/ask/AskBashGuardSpec.scala",
          "name": "validator refuses unknown and write commands"
        },
        {
          "path": "src/test/scala/nebflow/core/ask/AskBashGuardSpec.scala",
          "name": "validator is fail-closed on parse failures and limits"
        },
        {
          "path": "src/test/scala/nebflow/core/ask/AskBashGuardSpec.scala",
          "name": "executor runs read-only git subcommands with the pager pinned off"
        }
      ]
