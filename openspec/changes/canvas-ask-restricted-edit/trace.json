        {
          "path": "src/test/scala/nebflow/core/ask/AskEditReviewSpec.scala",
          "name": "accept(hunk) marks that block reviewed without writing; the rest stays pending"
        }
      ]
    },
    {
      "requirement": "CAE-REQ-001",
      "scenario": "CAE-SCN-002",
      "implementation": [
        "src/main/scala/nebflow/core/ask/AskEditReviews.scala",
        "openspec/changes/canvas-ask-restricted-edit/design.md",
        "openspec/changes/canvas-ask-restricted-edit/trace.json"
      ],
      "tests": [
        {
          "path": "src/test/scala/nebflow/core/ask/AskEditReviewSpec.scala",
          "name": "capture refuses other documents and foreign sessions, and normalises `..` / relative spellings"
        },
        {
          "path": "src/test/scala/nebflow/core/ask/AskEditReviewSpec.scala",
          "name": "capture follows identity through symlinks: same document passes, another target is refused"
        },
        {
          "path": "src/test/scala/nebflow/core/ask/AskEditReviewSpec.scala",
          "name": "accept and reject both refuse explicitly when the file changed during review; dismiss is the escape"
        }
      ]
    },
    {
