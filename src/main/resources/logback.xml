<configuration>

  <!-- Suppress harmless WebSocket disconnection stack traces from OS sleep/wake -->
  <turboFilter class="nebflow.core.WsTimeoutFilter"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %msg%n</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <!-- #36: honor NEBFLOW_HOME (isolated instances / canary) so their FILE
         logs land in their own data root instead of the host's. Falls back
         to the default data root when unset. -->
    <file>${NEBFLOW_HOME:-${user.home}/.nebflow}/logs/nebflow.log</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %replace(%msg){'\x1B\[[0-9;]*m', ''}%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${NEBFLOW_HOME:-${user.home}/.nebflow}/logs/nebflow.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxHistory>7</maxHistory>
      <totalSizeCap>200MB</totalSizeCap>
      <maxFileSize>50MB</maxFileSize>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>DEBUG</level>
    </filter>
  </appender>

  <logger name="org.http4s" level="WARN"/>
  <logger name="org.eclipse.jetty" level="WARN"/>
  <logger name="io.netty" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
