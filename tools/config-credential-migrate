#!/usr/bin/env python3
"""Migrate provider/search config keys; never print credential values.

Backup contains the original plaintext config and secrets. Keep it owner-only.
Operate only on an explicitly named isolated data root.
"""
import argparse
import datetime
import json
import os
import pathlib
import re
import shutil
import stat
import tempfile
import uuid

REF = re.compile(r"^secret:config-[a-f0-9]{32}$")


def atomic(path, data):
    fd, name = tempfile.mkstemp(prefix='.credential-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def fields(config):
    providers = config.get('llm', {}).get('providers', {})
    if not isinstance(providers, dict):
        raise ValueError('invalid providers')
    for name, provider in providers.items():
        if isinstance(provider, dict) and isinstance(provider.get('apiKey'), str):
            yield 'provider:' + name, provider, 'apiKey'
    search = config.get('search', {})
    if isinstance(search, dict) and isinstance(search.get('apiKey'), str):
        yield 'search', search, 'apiKey'


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--root', required=True)
    p.add_argument('--rollback', metavar='BACKUP')
    args = p.parse_args()
    root = pathlib.Path(args.root).resolve(strict=True)
    if root == (pathlib.Path.home() / '.stand').resolve():
        raise ValueError('refusing formal data root')
    config = root / 'stand.json'
    secrets = root / 'secrets'
    if args.rollback:
        backup = pathlib.Path(args.rollback).resolve(strict=True)
        if backup.parent != root / 'credential-migration-backups':
            raise ValueError('backup must belong to this data root')
        saved = backup / 'stand.json'
        marker = backup / 'secrets-present'
        if not saved.is_file() or not marker.is_file():
            raise ValueError('incomplete backup')
        # Preserve a rollback staging copy, then swap the directory. Existing
        # secrets are retained in the staging backup to avoid silent data loss.
        stage = root / ('.rollback-secrets-' + uuid.uuid4().hex)
        if marker.read_text() == 'yes':
            shutil.copytree(backup / 'secrets', stage, symlinks=True)
        if secrets.exists():
            os.replace(secrets, root / ('.secrets-before-rollback-' + uuid.uuid4().hex))
        if stage.exists():
            os.replace(stage, secrets)
        atomic(config, saved.read_bytes())
        print('rollback: restored configuration and secrets; previous secrets preserved')
        return
    raw = config.read_bytes()
    tree = json.loads(raw)
    pending = [(label, obj, key) for label, obj, key in fields(tree)
               if obj[key] and not REF.fullmatch(obj[key])]
    if not pending:
        print('无需迁移')
        return
    backupbase = root / 'credential-migration-backups'
    backupbase.mkdir(mode=0o700, exist_ok=True)
    os.chmod(backupbase, 0o700)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    backup = backupbase / (stamp + '-' + uuid.uuid4().hex[:8])
    backup.mkdir(mode=0o700)
    atomic(backup / 'stand.json', raw)
    (backup / 'secrets-present').write_text('yes' if secrets.exists() else 'no')
    os.chmod(backup / 'secrets-present', 0o600)
    if secrets.exists():
        shutil.copytree(secrets, backup / 'secrets', symlinks=True)
    secrets.mkdir(mode=0o700, exist_ok=True)
    os.chmod(secrets, 0o700)
    for label, obj, key in pending:
        name = 'config-' + uuid.uuid4().hex
        atomic(secrets / name, obj[key].encode('utf-8'))
        obj[key] = 'secret:' + name
    atomic(config, (json.dumps(tree, ensure_ascii=False, indent=2) + '\n').encode())
    print('backup: ' + str(backup))
    print('migrated fields: ' + ', '.join(label for label, _, _ in pending))
    print('WARNING: backup contains original credentials; keep it owner-only')


if __name__ == '__main__':
    try:
        main()
    except Exception as e:
        print('migration failed: ' + type(e).__name__)
        raise SystemExit(1)
