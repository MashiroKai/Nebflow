def normalize_tag(arg, namespace):
    """--project/--topic 的参数宽容化：`#proj/stand`、`proj/stand`、`stand` 等价。"""
    text = (arg or "").strip().lstrip("#")
    for prefix in (namespace + "/", "proj/" if namespace == "project" else None):
        if prefix and text.startswith(prefix):
            text = text[len(prefix):]
    return text


def query_by_tag(con, facet, value):
    return [r["term_id"] for r in con.execute(
        "SELECT term_id FROM term_tags WHERE facet = ? AND value = ?", (facet, value))]


def resolve_name(con, target, fuzzy=False):
    """精确名 → 精确别名 → （--fuzzy）子串。返回按 name_key 排序的汇总行。"""
    key = name_key(target)
    rows = con.execute(
        "SELECT * FROM v_term_summary WHERE name_key = ? ORDER BY project, rel, line",
        (key,)).fetchall()
    if not rows:
        rows = con.execute(
            "SELECT DISTINCT s.* FROM v_term_summary s JOIN term_aliases a"
            " ON a.term_id = s.term_id WHERE a.alias_key = ?"
            " ORDER BY s.project, s.rel, s.line", (key,)).fetchall()
    if not rows and fuzzy:
        needle = f"%{key}%"
        rows = con.execute(
            "SELECT DISTINCT s.* FROM v_term_summary s LEFT JOIN term_aliases a"
            " ON a.term_id = s.term_id"
            " WHERE s.name_key LIKE ? OR a.alias_key LIKE ?"
            " ORDER BY s.name_key, s.project, s.rel", (needle, needle)).fetchall()
    return rows


def cmd_list(con, args, root_project):
    sql = ["SELECT * FROM v_term_summary WHERE 1 = 1"]
    params = []
    if args.project:
        value = normalize_tag(args.project, "project")
        if not value:
            fail(EXIT_USAGE, "--project 需要一个标签值（如 stand / #proj/stand）")
        sql.append("AND EXISTS (SELECT 1 FROM term_tags x WHERE x.term_id ="
                   " v_term_summary.term_id AND x.facet = 'project' AND x.value = ?)")
        params.append(value)
    if args.topic:
        value = normalize_tag(args.topic, "topic")
        if not value:
            fail(EXIT_USAGE, "--topic 需要一个标签值（如 term-index / #topic/term-index）")
        sql.append("AND EXISTS (SELECT 1 FROM term_tags x WHERE x.term_id ="
                   " v_term_summary.term_id AND x.facet = 'topic' AND x.value = ?)")
        params.append(value)
    if args.source:
        sql.append("AND source = ?")
        params.append(args.source)
    if root_project and not args.project:
        sql.append("AND project = ?")
        params.append(root_project)
    sql.append("ORDER BY name_key, project, rel, line")
    rows = con.execute(" ".join(sql), params).fetchall()
    limit = args.limit if args.limit is not None else 50
    if limit and limit > 0:
        shown = rows[:limit]
    else:
        shown = rows
    if args.json:
        print(json.dumps({
            "count": len(rows), "shown": len(shown),
            "filters": {"project": args.project, "topic": args.topic,
                        "source": args.source, "limit": limit},
            "results": [summary_json(r, with_definition=False) for r in shown],
        }, ensure_ascii=False, indent=1))
        return EXIT_OK if rows else EXIT_NONE
    if not rows:
        print("（无结果：没有匹配的词条——放宽 --project/--topic/--source 或先 rebuild）")
        return EXIT_NONE
    note = ""
    if limit and limit > 0 and len(rows) > limit:
        note = f"（显示 {limit}/{len(rows)} 条；--limit 0 看全部）"
    print(render_terms(shown, note))
    return EXIT_OK


