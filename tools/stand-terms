#!/usr/bin/env python3
# stand-terms — 词条索引库 + 查询 CLI（stand 仓 tools/）
#
# 用途：把「词条注册表」从 vault 里的正文块锚抽成**可查询的库**——词条名/别名/
#       定义/标签/被引用位置一枪答完，供 agent（节点 / delegate / 引擎读侧）与
#       作者按名检索，不必 grep 四百个 Markdown 文件。
#       库是**派生物**：文档是事实源，库可删可重建，任何时刻 rebuild 一次即最新。
#
# 数据源（单一抽取出口，绝不自己重新解析词条语法）：
#   词条面 = 插件脚本的机器出口
#       python3 <scripts>/check_wiki_docs.py --root <vault> --project <name> \
#               --dump-terms --json
#     输出 {root, generated_at, terms:[{name,aliases,rel,anchor,line,end_line,
#     definition,source,tags:{project,topic,extra}}], refs:[{name_key,from_rel,
#     line,raw,resolved}]}；本工具只**消费**它（解析口径单源，跨语言一致性由
#     该出口保证）。不再对正文做第二次词条抽取。
#   文档面 = vault 内 .md/.markdown/.html 文件（标题取首个 H1、type/status 取
#     front-matter 顶层标量、mtime/size 取磁盘事实）——只补文档元数据，不碰词条。
#   vault 落位 = <data_root>/projects/<项目>/.stand/docs（与插件脚本
#     resolve_project_docs_root 同口径；项目枚举 = <data_root>/projects/*/ 下
#     有 project.json 的目录）。
#   数据根解析序（与引擎 PathUtil.dataRoot / 插件脚本同序，刻意**不**读
#     STAND_DATA_ROOT——保持与抽取出口同一把尺）：
#         STAND_HOME → NEBFLOW_HOME → ~/.stand
#
# 库：默认 <data_root>/wiki-index/terms.db（--db 覆盖）。全库单文件、多项目
#   统一管理（每个项目一个 documents.project 分桶）。schema 见 SCHEMA_SQL：
#     meta(key,value)                       schema_version / last_rebuild / rebuild_source
#     documents(id,project,rel,abs_path,title,doc_type,status,mtime,size,
#               term_count,scanned_at, UNIQUE(project,rel))
#     terms(id,doc_id→documents,name,name_key,anchor,line,end_line,definition,
#           source,raw_name,updated_at, UNIQUE(doc_id,anchor))
#     term_aliases(term_id,alias,alias_key, PK(term_id,alias_key))
#     term_tags(term_id,facet,value, PK(term_id,facet,value))
#     term_refs(id,term_id,from_doc_id,from_rel,line,raw,resolved)
#        term_id  = 本工具按**清洗后的查找键**消解（`- ` 列表前缀不进查找键）；
#        resolved = 抽取出口的判定原文（上游口径：`- ` 前缀会害它消解失败）。
#        两者可不等：term_id 有值而 resolved=0 是**上游已知缺陷**的显形，不是脏数据——
#        引用确实指向该词条（查询面据此统计 ref_count），只是引擎侧不认。
#     索引 idx_terms_key(name_key) / idx_tags(facet,value)
#     视图 v_term_summary（词条名 → 定义文档/锚点/标签/被引用次数/最后更新时间）
#
# 用法：
#   stand-terms rebuild [--root <vault>] [--project <名>] [--db PATH] [--scripts DIR]
#   stand-terms list [--project <tag>] [--topic <tag>] [--source glossary|doc]
#                    [--limit N] [--json]
#   stand-terms show <词条名> [--fuzzy] [--json]
#   stand-terms doc <rel 或 basename> [--project <tag>] [--json]
#   stand-terms refs <词条名> [--fuzzy] [--json]
#   stand-terms stats [--json]
#   通用选项：--db PATH（默认 <data_root>/wiki-index/terms.db）| --json | --root <vault>
#     （rebuild = 只索引该 vault；查询命令 = 从该 vault 路径推出项目名并按其过滤）
#
#   例：
#     tools/stand-terms rebuild                       # 全数据根所有项目 → 默认库
#     tools/stand-terms show 墨族                      # 精确（含别名精确）
#     tools/stand-terms show 墨 --fuzzy                # 子串模糊
#     tools/stand-terms list --project stand --limit 20
#     tools/stand-terms list --topic term-index
#     tools/stand-terms doc GLOSSARY.md
#     tools/stand-terms refs 词条索引库
#     tools/stand-terms stats --json
#
# 脚本定位（词条抽取出口找不到就说不清「数据从哪来」，故单独一条退出码）：
#   --scripts DIR > 环境变量 STAND_WIKI_DOCS_SCRIPTS > <data_root>/plugins/
#   visual-report/skills/wiki-docs/scripts > 本工具所在仓的 seed 路径
#   （../src/main/resources/seed/plugins/visual-report/skills/wiki-docs/scripts）。
#
# 退出码：0 = 成功；1 = 无结果（词条/文档/引用查不到，或没有可索引的 vault）；
#   2 = 用法错（参数非法、--root 推不出项目名）；3 = 库不存在（提示先 rebuild）；
#   4 = 找不到 check_wiki_docs.py（含修复提示）。
#
# 零第三方依赖：Python3 标准库（argparse/json/os/re/sqlite3/subprocess/unicodedata）。
# 写面只有两处：库文件本身（rebuild）、以及 SQLite 的 -wal/-shm 旁文件。

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
import unicodedata
from datetime import datetime
from pathlib import Path

SCHEMA_VERSION = "1"
CHECK_SCRIPT_NAME = "check_wiki_docs.py"
DATA_ROOT_ENV_VARS = ("STAND_HOME", "NEBFLOW_HOME")
SCRIPTS_ENV_VAR = "STAND_WIKI_DOCS_SCRIPTS"
DEFAULT_HOME_DIRNAME = ".stand"
INDEX_REL = ("wiki-index", "terms.db")
PLUGIN_SCRIPTS_REL = ("plugins", "visual-report", "skills", "wiki-docs", "scripts")
SEED_SCRIPTS_REL = ("src", "main", "resources", "seed") + PLUGIN_SCRIPTS_REL
DOC_EXTENSIONS = {".md", ".markdown", ".html"}

EXIT_OK = 0
EXIT_NONE = 1
EXIT_USAGE = 2
EXIT_NO_DB = 3
EXIT_NO_SCRIPT = 4

# 词条名清洗：上游 name 保留列表符号（`- 墨族（ink family）`），库里存干净名，
# 原文另存 terms.raw_name 以便回溯。
LIST_BULLET_RE = re.compile(r"^\s*(?:[-*+]\s+|\d+[.)]\s+)")
NAME_SEP_RE = re.compile(r"\s*[—–]\s*|\s*[:：]\s*")
TAG_TOKEN_RE = re.compile(r"(?:^|\s)#[A-Za-z0-9_.\-\u4e00-\u9fa5]+/[A-Za-z0-9_.\-\u4e00-\u9fa5]+")
ANCHOR_TOKEN_RE = re.compile(r"\s\^[A-Za-z0-9][A-Za-z0-9-]*")
H1_RE = re.compile(r"^#\s+(.+?)\s*$")
FM_KV_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*)\s*:\s*(.*)$")


# ── 退出与输出 ───────────────────────────────────────────────────────


def fail(code, msg, hint=None):
    """统一错误出口：stderr 一行原因 + 可选修复提示，然后退出。"""
    print(f"ERROR: {msg}", file=sys.stderr)
    if hint:
        print(f"  修复：{hint}", file=sys.stderr)
    sys.exit(code)


def fmt_ts(ts):
    return ts or "-"


# ── 路径解析（与插件脚本同序同公式，别自创）──────────────────────────


def resolve_data_root(explicit=None):
    """数据根：--data-root/显式 > STAND_HOME > NEBFLOW_HOME > ~/.stand。"""
    if explicit:
        return Path(os.path.expanduser(str(explicit)))
    for key in DATA_ROOT_ENV_VARS:
        raw = (os.environ.get(key) or "").strip()
        if raw:
            return Path(os.path.expanduser(raw))
    return Path.home() / DEFAULT_HOME_DIRNAME


def project_vault(data_root, project):
    """项目名 → vault：<data_root>/projects/<project>/.stand/docs。"""
    return data_root / "projects" / project / ".stand" / "docs"


def enumerate_vaults(data_root):
    """项目枚举：<data_root>/projects/*/ 下有 project.json 的目录（有 .stand/docs 才收）。"""
    pdir = data_root / "projects"
    out = []
    if not pdir.is_dir():
        return out
    for entry in sorted(pdir.iterdir(), key=lambda p: p.name):
        if not entry.is_dir():
            continue
        if not (entry / "project.json").is_file():
            continue
        vault = entry / ".stand" / "docs"
        if vault.is_dir():
            out.append((entry.name, vault))
    return out


def infer_project(vault):
    """vault 路径 → 项目名（只认 <root>/projects/<name>/.stand/docs 这一种形状）。"""
    parts = Path(vault).resolve().parts
    if len(parts) >= 3 and parts[-1] == "docs" and parts[-2] == ".stand" and parts[-4] == "projects":
        return parts[-3]
    return None


# ── 词条抽取出口定位 ─────────────────────────────────────────────────


def script_supports_dump(path):
    """该副本是否带 --dump-terms 出口（旧版插件副本没有；只读源码探测，零执行）。"""
    try:
        return "--dump-terms" in path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def find_script(explicit, data_root):
    """按固定次序定位抽取出口，返回 (path|None, source|None, stale|[], tried|[])。

    次序：--scripts > $STAND_WIKI_DOCS_SCRIPTS > <data_root>/plugins/... >
    仓内 seed。**但只认带 --dump-terms 的副本**——已安装插件副本可能落后于
    seed（老版本没有该出口），此时跳过并记入 stale（stderr 明示，不静默降级）；
    若一个都没有则退回「第一个存在的副本」让调用方报错并把话说清楚。"""
    cands = []
    if explicit:
        cands.append(("--scripts", Path(os.path.expanduser(str(explicit)))))
    env = (os.environ.get(SCRIPTS_ENV_VAR) or "").strip()
    if env:
        cands.append((f"${SCRIPTS_ENV_VAR}", Path(os.path.expanduser(env))))
    cands.append(("插件安装路径", data_root.joinpath(*PLUGIN_SCRIPTS_REL)))
    cands.append(("仓内 seed", Path(__file__).resolve().parent.joinpath("..").joinpath(*SEED_SCRIPTS_REL)))

    tried, stale, first_existing = [], [], None
    for source, cand in cands:
        path = cand if cand.suffix == ".py" else cand / CHECK_SCRIPT_NAME
        if not path.is_file():
            tried.append(f"{source}: {path}（不存在）")
            continue
        tried.append(f"{source}: {path}")
        if first_existing is None:
            first_existing = (path, source)
        if script_supports_dump(path):
            return path, source, stale, tried
        stale.append(f"{source}: {path}")
    if first_existing:
        return first_existing[0], first_existing[1], stale, tried
    return None, None, stale, tried


def run_dump(script, vault, project):
    """调插件机器出口，返回解析好的 JSON（形状见文件头）。"""
    cmd = [sys.executable, str(script), "--root", str(vault),
           "--project", project, "--dump-terms", "--json"]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout or "").strip().splitlines()
        raise RuntimeError(f"抽取失败（{vault}，exit={proc.returncode}）："
                           + (" / ".join(tail[-3:]) or "无输出"))
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"抽取输出不是合法 JSON（{vault}）：{exc}")
    for key in ("terms", "refs"):
        if key not in data:
            raise RuntimeError(f"抽取输出缺 {key} 键（{vault}）——先升级插件脚本")
    return data


# ── 文档元数据（只补标题/类型/状态；词条一律走抽取出口）──────────────


def parse_doc_meta(text, rel):
    """→ (title, doc_type, status)。front-matter 顶层标量 + 首个围栏外 H1。"""
    doc_type = status = ""
    lines = text.splitlines()
    start = 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            line = lines[i]
            if line.strip() == "---":
                start = i + 1
                break
            m = FM_KV_RE.match(line)
            if not m:
                continue
            key, value = m.group(1), m.group(2).strip().strip('"').strip("'")
            if key == "type" and not doc_type:
                doc_type = value
            elif key == "status" and not status:
                status = value
    title = ""
    in_fence = False
    for line in lines[start:]:
        stripped = line.strip()
        if stripped.startswith("```") or stripped.startswith("~~~"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = H1_RE.match(line)
        if m:
            title = m.group(1).strip()
            break
    if not title:
        title = Path(rel).stem
    return title, doc_type, status


def scan_documents(vault):
    """vault 内文档清单（rel/abs/mtime/size/title/type/status）；读不了的跳过（同插件）。"""
    rows = []
    for path in sorted(vault.rglob("*")):
        if not path.is_file():
            continue
        if path.suffix.lower() not in DOC_EXTENSIONS:
            continue
        rel = path.relative_to(vault).as_posix()
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        try:
            st = path.stat()
            mtime, size = int(st.st_mtime), int(st.st_size)
        except OSError:
            mtime, size = 0, 0
        title, doc_type, status = parse_doc_meta(text, rel)
        rows.append({"rel": rel, "abs_path": str(path), "title": title,
                     "doc_type": doc_type, "status": status,
                     "mtime": mtime, "size": size})
    rows.sort(key=lambda r: r["rel"])
    return rows


# ── 名字归一 ─────────────────────────────────────────────────────────


def clean_name(raw):
    """上游名字 → 干净显示名：去列表符号、去包裹强调。"""
    text = (raw or "").strip()
    text = LIST_BULLET_RE.sub("", text)
    text = text.strip().strip("*").strip()
    return re.sub(r"\s+", " ", text)


def name_key(raw):
    """查找键：干净名、小写、空白折叠（大小写不敏感 = 精确判定口径）。"""
    return clean_name(raw).lower()


def short_definition(definition, name, limit=120):
    """单行定义摘录（库里存原文整段；展示侧按本词条位置截取到下一个块锚之前）。"""
    blob = re.sub(r"\s+", " ", definition or "").strip()
    idx = blob.find(name) if name else -1
    seg = blob[idx + len(name):] if idx >= 0 else blob
    m = NAME_SEP_RE.search(seg)
    if m:
        seg = seg[m.end():]
    # 同一段落里并列多条词条：本条定义到下一个 `^块锚` 为止
    cut = ANCHOR_TOKEN_RE.search(seg)
    if cut:
        seg = seg[:cut.start()]
    seg = TAG_TOKEN_RE.sub(" ", seg)
    seg = re.sub(r"\s+", " ", seg).strip()
    if len(seg) > limit:
        seg = seg[:limit].rstrip() + "…"
    return seg or "-"


# ── schema ───────────────────────────────────────────────────────────

SCHEMA_SQL = """
PRAGMA journal_mode = WAL;
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS meta (
    key   TEXT PRIMARY KEY,
    value TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS documents (
    id         INTEGER PRIMARY KEY,
    project    TEXT NOT NULL,
    rel        TEXT NOT NULL,
    abs_path   TEXT NOT NULL DEFAULT '',
    title      TEXT NOT NULL DEFAULT '',
    doc_type   TEXT NOT NULL DEFAULT '',
    status     TEXT NOT NULL DEFAULT '',
    mtime      INTEGER NOT NULL DEFAULT 0,
    size       INTEGER NOT NULL DEFAULT 0,
    term_count INTEGER NOT NULL DEFAULT 0,
    scanned_at TEXT NOT NULL DEFAULT '',
    UNIQUE(project, rel)
);

CREATE TABLE IF NOT EXISTS terms (
    id         INTEGER PRIMARY KEY,
    doc_id     INTEGER NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
    name       TEXT NOT NULL,
    name_key   TEXT NOT NULL,
    anchor     TEXT NOT NULL,
    line       INTEGER NOT NULL,
    end_line   INTEGER NOT NULL,
    definition TEXT NOT NULL DEFAULT '',
    source     TEXT NOT NULL,
    raw_name   TEXT NOT NULL DEFAULT '',
    updated_at TEXT NOT NULL DEFAULT '',
    UNIQUE(doc_id, anchor)
);

CREATE TABLE IF NOT EXISTS term_aliases (
    term_id   INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE,
    alias     TEXT NOT NULL,
    alias_key TEXT NOT NULL,
    PRIMARY KEY(term_id, alias_key)
);

CREATE TABLE IF NOT EXISTS term_tags (
    term_id INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE,
    facet   TEXT NOT NULL,
    value   TEXT NOT NULL,
    PRIMARY KEY(term_id, facet, value)
);

CREATE TABLE IF NOT EXISTS term_refs (
    id          INTEGER PRIMARY KEY,
    term_id     INTEGER REFERENCES terms(id) ON DELETE CASCADE,
    from_doc_id INTEGER REFERENCES documents(id) ON DELETE CASCADE,
    from_rel    TEXT NOT NULL DEFAULT '',
    line        INTEGER NOT NULL DEFAULT 0,
    raw         TEXT NOT NULL DEFAULT '',
    resolved    INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_terms_key ON terms(name_key);
CREATE INDEX IF NOT EXISTS idx_tags      ON term_tags(facet, value);
CREATE INDEX IF NOT EXISTS idx_refs_term ON term_refs(term_id);
CREATE INDEX IF NOT EXISTS idx_docs_rel  ON documents(project, rel);

-- 一枪答完「词条名 → 定义文档/锚点/标签/被引用次数/最后更新时间」。
-- group_concat 的桶内顺序依赖插入顺序（rebuild 按 key 排序写入，故确定）。
CREATE VIEW IF NOT EXISTS v_term_summary AS
SELECT t.id                                   AS term_id,
       t.name                                 AS name,
       t.name_key                             AS name_key,
       d.project                              AS project,
       d.rel                                  AS rel,
       t.anchor                               AS anchor,
       t.line                                 AS line,
       t.end_line                             AS end_line,
       t.definition                           AS definition,
       t.source                               AS source,
       t.updated_at                           AS updated_at,
       COALESCE((SELECT group_concat(a.alias, ',')
                 FROM term_aliases a WHERE a.term_id = t.id), '')        AS aliases,
       COALESCE((SELECT group_concat(x.facet || '/' || x.value, ',')
                 FROM term_tags x WHERE x.term_id = t.id), '')           AS tags,
       COALESCE((SELECT group_concat(x.value, ',')
                 FROM term_tags x WHERE x.term_id = t.id AND x.facet = 'project'), '') AS project_tags,
       COALESCE((SELECT group_concat(x.value, ',')
                 FROM term_tags x WHERE x.term_id = t.id AND x.facet = 'topic'), '')   AS topic_tags,
       (SELECT count(*) FROM term_refs r WHERE r.term_id = t.id)        AS ref_count
FROM terms t
JOIN documents d ON d.id = t.doc_id;
"""


def connect(db_path, create=False):
    if not create and not Path(db_path).is_file():
        fail(EXIT_NO_DB, f"索引库不存在：{db_path}",
             "先建库：tools/stand-terms rebuild（默认写到 <data_root>/wiki-index/terms.db）")
    Path(db_path).parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(str(db_path))
    con.row_factory = sqlite3.Row
    con.execute("PRAGMA journal_mode = WAL")
    con.execute("PRAGMA foreign_keys = ON")
    return con


def open_query_db(db_path):
    con = connect(db_path)
    try:
        con.execute("SELECT 1 FROM v_term_summary LIMIT 1")
    except sqlite3.Error:
        con.close()
        fail(EXIT_NO_DB, f"库文件不是词条索引（缺 v_term_summary）：{db_path}",
             "删掉重建：tools/stand-terms rebuild")
    return con


def meta_of(con):
    try:
        return {r["key"]: r["value"] for r in con.execute("SELECT key, value FROM meta")}
    except sqlite3.Error:
        return {}


# ── rebuild ──────────────────────────────────────────────────────────


def cmd_rebuild(args, data_root):
    script, source, stale, tried = find_script(args.scripts, data_root)
    if script is None:
        fail(EXIT_NO_SCRIPT,
             "找不到词条抽取出口 " + CHECK_SCRIPT_NAME + "（尝试过：\n    "
             + "\n    ".join(tried) + "）",
             "用 --scripts <wiki-docs/scripts 目录> 显式指定，或 "
             f"export {SCRIPTS_ENV_VAR}=<同目录>，或安装 visual-report 插件"
             f"（应为 {data_root.joinpath(*PLUGIN_SCRIPTS_REL)}）")
    for item in stale:
        print(f"注意：跳过不带 --dump-terms 的副本（版本落后）：{item}", file=sys.stderr)
    if stale and not script_supports_dump(script):
        fail(EXIT_NO_SCRIPT,
             f"找到的 {CHECK_SCRIPT_NAME} 都不带 --dump-terms 出口：{script}",
             "插件副本落后于 seed——用 --scripts 指向 "
             f"<仓>/src/main/resources/seed/{'/'.join(PLUGIN_SCRIPTS_REL)}，"
             "或重装 visual-report 插件")

    if args.root:
        vault = Path(os.path.expanduser(str(args.root)))
        if not vault.is_dir():
            fail(EXIT_USAGE, f"--root 不是目录：{vault}")
        project = (args.project or "").strip() or infer_project(vault) or "local"
        vaults = [(project, vault)]
    else:
        vaults = enumerate_vaults(data_root)
        if not vaults:
            fail(EXIT_NONE, f"{data_root}/projects/ 下没有带 .stand/docs 的项目 vault",
                 "项目 vault 落位 = <data_root>/projects/<项目>/.stand/docs")
        if (args.project or "").strip():
            keep = args.project.strip()
            vaults = [(p, v) for p, v in vaults if p == keep]
            if not vaults:
                fail(EXIT_NONE, f"项目 {keep} 没有 .stand/docs vault")

    db_path = Path(os.path.expanduser(str(args.db))) if args.db else data_root.joinpath(*INDEX_REL)
    now = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    con = connect(db_path, create=True)
    con.executescript(SCHEMA_SQL)

    stats = {"vaults": [], "documents": 0, "terms": 0, "aliases": 0,
             "tags": 0, "refs": 0, "refs_resolved": 0, "duplicate_anchors": 0,
             "skipped": []}
    try:
        with con:  # 单一事务：先清后插（全量替换 = 确定性）
            for table in ("term_refs", "term_aliases", "term_tags", "terms",
                          "documents", "meta"):
                con.execute(f"DELETE FROM {table}")

            for project, vault in vaults:
                data = run_dump(script, vault, project)
                api_terms = data["terms"]
                doc_rows = {r["rel"]: r for r in scan_documents(vault)}
                term_counts = {}
                for t in api_terms:
                    term_counts[t["rel"]] = term_counts.get(t["rel"], 0) + 1
                # 抽取出口报到的文档必须进 documents（防御：README 等在 vault 外的边界）
                for rel in term_counts:
                    if rel not in doc_rows:
                        abs_path = vault / rel
                        try:
                            st = abs_path.stat()
                            mtime, size = int(st.st_mtime), int(st.st_size)
                        except OSError:
                            mtime, size = 0, 0
                        doc_rows[rel] = {"rel": rel, "abs_path": str(abs_path),
                                         "title": Path(rel).stem, "doc_type": "",
                                         "status": "", "mtime": mtime, "size": size}

                doc_ids = {}
                for rel in sorted(doc_rows):
                    row = doc_rows[rel]
                    cur = con.execute(
                        "INSERT INTO documents (project, rel, abs_path, title, doc_type,"
                        " status, mtime, size, term_count, scanned_at)"
                        " VALUES (?,?,?,?,?,?,?,?,?,?)",
                        (project, rel, row["abs_path"], row["title"], row["doc_type"],
                         row["status"], row["mtime"], row["size"],
                         term_counts.get(rel, 0), now))
                    doc_ids[rel] = cur.lastrowid
                stats["documents"] += len(doc_rows)

                keys = {}   # 查找键 → [(term_id, source)]
                seen_anchors = set()
                v_terms = v_aliases = v_tags = 0
                for t in sorted(api_terms, key=lambda x: (x["rel"], x["line"], x["name"])):
                    doc_id = doc_ids[t["rel"]]
                    anchor = t["anchor"]
                    if (doc_id, anchor) in seen_anchors:
                        stats["duplicate_anchors"] += 1
                        stats["skipped"].append(f"{project}:{t['rel']} {anchor}（块锚重复，保留首条）")
                        continue
                    seen_anchors.add((doc_id, anchor))
                    display = clean_name(t["name"])
                    key = name_key(t["name"])
                    cur = con.execute(
                        "INSERT INTO terms (doc_id, name, name_key, anchor, line, end_line,"
                        " definition, source, raw_name, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?)",
                        (doc_id, display, key, anchor, int(t["line"]), int(t["end_line"]),
                         t.get("definition", ""), t.get("source", "doc"),
                         t["name"], now))
                    term_id = cur.lastrowid
                    v_terms += 1
                    keys.setdefault(key, []).append((term_id, t.get("source", "doc")))
                    aliases = {}
                    for alias in t.get("aliases") or []:
                        akey = name_key(alias)
                        araw = clean_name(alias)
                        if not akey or akey in aliases:
                            continue
                        aliases[akey] = araw
                    for akey in sorted(aliases):
                        con.execute("INSERT OR IGNORE INTO term_aliases"
                                    " (term_id, alias, alias_key) VALUES (?,?,?)",
                                    (term_id, aliases[akey], akey))
                        keys.setdefault(akey, []).append((term_id, t.get("source", "doc")))
                        v_aliases += 1
                    tags = t.get("tags") or {}
                    triples = []
                    for bucket, facet in (("project", "project"), ("topic", "topic")):
                        for value in tags.get(bucket) or []:
                            triples.append((facet, value))
                    for extra in tags.get("extra") or []:
                        if "/" not in extra:
                            continue
                        facet, value = extra.split("/", 1)
                        triples.append((facet.strip(), value.strip()))
                    for facet, value in sorted(set(triples)):
                        if not facet or not value:
                            continue
                        con.execute("INSERT OR IGNORE INTO term_tags"
                                    " (term_id, facet, value) VALUES (?,?,?)",
                                    (term_id, facet, value))
                        v_tags += 1
                stats["terms"] += v_terms
                stats["aliases"] += v_aliases
                stats["tags"] += v_tags

                refs = refs_of(con, data["refs"], doc_ids, keys, stats)
                stats["refs"] += refs[0]
                stats["refs_resolved"] += refs[1]
                stats["vaults"].append({"project": project, "vault": str(vault),
                                        "documents": len(doc_rows), "terms": v_terms,
                                        "refs": refs[0]})

            meta_rows = [
                ("schema_version", SCHEMA_VERSION),
                ("last_rebuild", now),
                ("rebuild_source", "vaults=" + ",".join(p for p, _v in vaults)
                 + f";script={script}"),
            ]
            for key, value in meta_rows:
                con.execute("INSERT OR REPLACE INTO meta (key, value) VALUES (?,?)",
                            (key, value))
    except RuntimeError as exc:
        try:
            con.rollback()
        except sqlite3.Error:
            pass
        con.close()
        fail(EXIT_NONE, str(exc), "确认插件脚本可独立运行："
             f"python3 {script} --root <vault> --dump-terms --json")
    else:
        # 提交换档 + checkpoint：确保落库完整（WAL 侧文件可被 --dump 完整读到）
        con.commit()
        try:
            con.execute("PRAGMA wal_checkpoint(TRUNCATE)")
        except sqlite3.Error:
            pass
        con.close()

    payload = {"db": str(db_path), "schema_version": SCHEMA_VERSION,
               "last_rebuild": now, "script": str(script), "script_source": source,
               **{k: v for k, v in stats.items()}}
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=1))
        return EXIT_OK

    print(f"索引库：{db_path}")
    print(f"schema 版本：{SCHEMA_VERSION}　最后重建：{now}")
    print(f"抽取出口：{script}（来源：{source}）")
    print()
    rows = [(v["project"], str(v["documents"]), str(v["terms"]), str(v["refs"]), v["vault"])
            for v in stats["vaults"]]
    print(render_table(["项目", "文档", "词条", "引用", "vault"], rows,
                       aligns="rrrrl"))
    print()
    print(f"合计：文档 {stats['documents']}　词条 {stats['terms']}　"
          f"别名 {stats['aliases']}　标签 {stats['tags']}　"
          f"引用 {stats['refs']}（上游已消解 {stats['refs_resolved']}）")
    if stats["duplicate_anchors"]:
        print(f"警告：{stats['duplicate_anchors']} 个块锚重复（同文档内同锚），"
              "已保留首条：", file=sys.stderr)
        for line in stats["skipped"]:
            print(f"  {line}", file=sys.stderr)
    return EXIT_OK


def refs_of(con, api_refs, doc_ids, keys, stats):
    """写 term_refs；返回 (总引用数, 已消解引用数)。"""
    total = resolved = 0
    for ref in sorted(api_refs, key=lambda r: (r["from_rel"], r["line"], r["raw"])):
        key = (ref.get("name_key") or "").strip()
        hits = keys.get(key) or []
        glossary = [tid for tid, src in hits if src == "glossary"]
        if len(glossary) == 1:
            term_id = glossary[0]
        elif not glossary and len({tid for tid, _s in hits}) == 1:
            term_id = hits[0][0]
        else:
            term_id = None
        con.execute("INSERT INTO term_refs (term_id, from_doc_id, from_rel, line, raw,"
                    " resolved) VALUES (?,?,?,?,?,?)",
                    (term_id, doc_ids.get(ref["from_rel"]), ref["from_rel"],
                     int(ref["line"]), ref["raw"], 1 if ref.get("resolved") else 0))
        total += 1
        resolved += 1 if ref.get("resolved") else 0
    return total, resolved


# ── 展示（对齐列 + 中文标签；CJK 按双宽算）────────────────────────────


def display_width(text):
    width = 0
    for ch in text:
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width


def clip(text, width):
    if width <= 0:
        return ""
    if display_width(text) <= width:
        return text
    out, used = "", 0
    limit = width - 1
    for ch in text:
        w = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if used + w > limit:
            break
        out += ch
        used += w
    return out + "…"


def pad(text, width, align="l"):
    gap = max(0, width - display_width(text))
    if align == "r":
        return " " * gap + text
    return text + " " * gap


def render_table(headers, rows, aligns="l"):
    cells = [[str(c) for c in r] for r in rows]
    widths = [display_width(h) for h in headers]
    for row in cells:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], display_width(cell))
    lines = ["  ".join(pad(h, widths[i]) for i, h in enumerate(headers)).rstrip()]
    lines.append("  ".join("-" * widths[i] for i in range(len(headers))))
    for row in cells:
        lines.append("  ".join(pad(c, widths[i], aligns[i]) for i, c in enumerate(row)).rstrip())
    return "\n".join(lines)


def term_row(summary):
    return (summary["name"], summary["project_tags"] or "-",
            summary["topic_tags"] or "-", summary["source"],
            f"{summary['rel']}:{summary['line']}", str(summary["ref_count"]))


TERM_HEADERS = ["词条", "项目标签", "主题标签", "来源", "文档:行", "引用"]


def render_terms(items, limit_note=""):
    if not items:
        return ""
    rows = [term_row(s) for s in items]
    out = render_table(TERM_HEADERS, rows, aligns="lllllr")
    if limit_note:
        out += "\n" + limit_note
    return out


def summary_json(item, with_definition=True):
    data = {
        "name": item["name"],
        "aliases": [a for a in (item["aliases"] or "").split(",") if a],
        "project": item["project"],
        "rel": item["rel"],
        "anchor": item["anchor"],
        "line": item["line"],
        "end_line": item["end_line"],
        "source": item["source"],
        "tags": {"project": [t for t in (item["project_tags"] or "").split(",") if t],
                 "topic": [t for t in (item["topic_tags"] or "").split(",") if t],
                 "all": [t for t in (item["tags"] or "").split(",") if t]},
        "ref_count": item["ref_count"],
        "updated_at": item["updated_at"],
    }
    if with_definition:
        data["definition"] = short_definition(item["definition"], item["name"])
    return data


def render_term_detail(item, index=None):
    head = f"词条：{item['name']}"
    if index is not None:
        head = f"[{index}] " + head
    lines = [head]
    aliases = [a for a in (item["aliases"] or "").split(",") if a]
    lines.append(f"  别名：{'、'.join(aliases) if aliases else '-'}")
    lines.append(f"  来源：{item['source']}"
                 + ("（词表）" if item["source"] == "glossary" else "（文档声明块）"))
    lines.append(f"  位置：{item['rel']}:{item['line']}-{item['end_line']}"
                 f"　锚点 {item['anchor']}　文档项目 {item['project']}")
    tags = item["tags"] or "-"
    lines.append(f"  标签：{tags}")
    lines.append(f"  引用：{item['ref_count']} 处　更新：{fmt_ts(item['updated_at'])}")
    lines.append(f"  定义：{short_definition(item['definition'], item['name'], 300)}")
    return "\n".join(lines)


