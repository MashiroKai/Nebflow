def cmd_stats(con, args, root_project):
    where, params = "", []
    if root_project:
        where, params = " WHERE project = ?", [root_project]
    totals = {
        "terms": con.execute(f"SELECT count(*) FROM v_term_summary{where}", params).fetchone()[0],
        "documents": con.execute(
            "SELECT count(*) FROM documents" + (" WHERE project = ?" if root_project else ""),
            params).fetchone()[0],
        "documents_with_terms": con.execute(
            "SELECT count(*) FROM documents WHERE term_count > 0"
            + (" AND project = ?" if root_project else ""), params).fetchone()[0],
        "refs": con.execute("SELECT count(*) FROM term_refs").fetchone()[0],
        "refs_resolved": con.execute(
            "SELECT count(*) FROM term_refs WHERE resolved = 1").fetchone()[0],
        "aliases": con.execute("SELECT count(*) FROM term_aliases").fetchone()[0],
        "tags": con.execute("SELECT count(*) FROM term_tags").fetchone()[0],
    }
    scope = (" AND d.project = ?" if root_project else "")
    def dist(facet):
        return con.execute(
            "SELECT t.value AS value, count(*) AS n FROM term_tags t"
            " JOIN terms m ON m.id = t.term_id JOIN documents d ON d.id = m.doc_id"
            f" WHERE t.facet = ?{scope} GROUP BY t.value ORDER BY n DESC, t.value",
            [facet] + params).fetchall()
    by_project = [(r["value"], r["n"]) for r in dist("project")]
    by_topic = [(r["value"], r["n"]) for r in dist("topic")]
    by_source = [(r["source"], r["n"]) for r in con.execute(
        f"SELECT source, count(*) AS n FROM v_term_summary{where}"
        " GROUP BY source ORDER BY source", params).fetchall()]
    meta = meta_of(con)
    if args.json:
        print(json.dumps({
            "db": str(args.db_path), "schema_version": meta.get("schema_version", ""),
            "last_rebuild": meta.get("last_rebuild", ""),
            "rebuild_source": meta.get("rebuild_source", ""),
            "totals": totals,
            "by_project": [{"value": v, "terms": n} for v, n in by_project],
            "by_topic": [{"value": v, "terms": n} for v, n in by_topic],
            "by_source": [{"value": v, "terms": n} for v, n in by_source],
        }, ensure_ascii=False, indent=1))
        return EXIT_OK
    print(f"库：{args.db_path}")
    print(f"schema 版本：{meta.get('schema_version', '-')}　"
          f"最后重建：{fmt_ts(meta.get('last_rebuild'))}")
    print()
    print(f"总词条：{totals['terms']}　文档：{totals['documents']}"
          f"（其中带词条 {totals['documents_with_terms']}）　"
          f"引用：{totals['refs']}（上游已消解 {totals['refs_resolved']}）")
    print(f"别名：{totals['aliases']}　标签：{totals['tags']}")
    if not totals["terms"]:
        return EXIT_OK
    labels = {"glossary": "词表", "doc": "文档声明块"}
    print("\n按来源：")
    print(render_table(["来源", "词条"],
                       [(labels.get(v, v), str(n)) for v, n in by_source], aligns="lr"))
    def block(title, items, empty):
        print(f"\n{title}")
        if not items:
            print(f"  （{empty}）")
            return
        print(render_table(["标签", "词条"], [(v, str(n)) for v, n in items], aligns="lr"))
    block("按项目（#proj/…）：", by_project, "所有词条都缺 #proj/ 标签")
    block("按主题（#topic/…）：", by_topic, "所有词条都缺 #topic/ 标签")
    return EXIT_OK


# ── CLI ──────────────────────────────────────────────────────────────


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", default=argparse.SUPPRESS,
                        help="索引库路径（默认 <data_root>/wiki-index/terms.db）")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="机器形状输出（合法 JSON，stdout）")
    common.add_argument("--root", default=argparse.SUPPRESS,
                        help="vault 根（rebuild：只索引该 vault；查询：由路径推项目名并按项目过滤）")

    ap = argparse.ArgumentParser(
        prog="stand-terms",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="词条索引库 + 查询 CLI：vault 里的词条声明抽成 SQLite 库，按名/项目/主题/文档/引用查询。",
        epilog="""\
数据从哪来（唯一边界）：
  词条 = 插件脚本的机器出口 check_wiki_docs.py --dump-terms --json（本工具只消费，
  不第二次解析正文）；文档元数据 = vault 内 .md/.markdown/.html 的磁盘事实。
  库是派生物：文档是事实源，随时可删可重建。

vault 与数据根：
  vault = <data_root>/projects/<项目>/.stand/docs（项目 = 有 project.json 的目录）
  data_root = STAND_HOME → NEBFLOW_HOME → ~/.stand（与抽取出口同一把尺）

常用示例：
  %(prog)s rebuild                              # 全项目重建默认库
  %(prog)s rebuild --root ~/.stand/projects/stand/.stand/docs --db /tmp/t.db
  %(prog)s list --project stand --limit 20
  %(prog)s list --topic term-index
  %(prog)s show 墨族                             # 精确名/别名（大小写不敏感）
  %(prog)s show 墨 --fuzzy                       # 子串模糊
  %(prog)s doc GLOSSARY.md                       # rel 或 basename
  %(prog)s refs 词条索引库
  %(prog)s stats --json

退出码：0=成功 1=无结果 2=用法错 3=库不存在（先 rebuild）4=找不到 check_wiki_docs.py
""")
    ap.add_argument("--db", help="索引库路径（默认 <data_root>/wiki-index/terms.db）")
    ap.add_argument("--json", action="store_true", help="机器形状输出（合法 JSON，stdout）")
    ap.add_argument("--root", help="vault 根（rebuild：只索引该 vault；查询：推项目名过滤）")
    ap.add_argument("--data-root", help="数据根（默认 STAND_HOME > NEBFLOW_HOME > ~/.stand）")

    sub = ap.add_subparsers(dest="cmd")
    rb = sub.add_parser("rebuild", parents=[common],
                        help="重建索引库（单事务全量替换：先删后插）",
                        description="重建索引库：逐个项目 vault 调抽取出口，单事务全量替换。")
    rb.add_argument("--project", help="项目名（--root 时用作库内项目标签；缺省从路径推断）")
    rb.add_argument("--scripts", help="wiki-docs/scripts 目录（含 check_wiki_docs.py）或该脚本路径")

    ls = sub.add_parser("list", parents=[common], help="按项目/主题/来源过滤列词条")
    ls.add_argument("--project", help="按 #proj/<slug> 标签过滤（不是文档所属项目；接受 stand / proj/stand / #proj/stand）")
    ls.add_argument("--topic", help="按 #topic/<slug> 标签过滤（接受 term-index / #topic/term-index）")
    ls.add_argument("--source", choices=("glossary", "doc"), help="来源：glossary=词表，doc=文档声明块")
    ls.add_argument("--limit", type=int, default=50, help="最多显示 N 条（0 = 全部；默认 50）")

    sh = sub.add_parser("show", parents=[common], help="按词条名显示详情（精确优先）")
    sh.add_argument("name", help="词条名（含别名；大小写不敏感）")
    sh.add_argument("--fuzzy", action="store_true", help="精确未命中时走子串模糊（名与别名）")

    dc = sub.add_parser("doc", parents=[common], help="列某文档下的全部词条")
    dc.add_argument("target", help="vault 相对路径或 basename（如 GLOSSARY.md）")
    dc.add_argument("--project", help="只在某个项目里找同名文档")

    rf = sub.add_parser(
        "refs", parents=[common], help="列某词条被引用的位置",
        description="列某词条被引用的位置（from_rel:line + 原文）。引用归属按**清洗后的"
                    "查找键**消解（`- ` 列表前缀不进查找键）；「上游消解」列是抽取出口的"
                    "判定原文——两者不一致 = 上游已知的 `- ` 前缀缺陷（引用仍挂在该词条上，"
                    "只是引擎侧不认），不是脏数据。")
    rf.add_argument("name", help="词条名")
    rf.add_argument("--fuzzy", action="store_true", help="子串模糊匹配")

    sub.add_parser("stats", parents=[common], help="总量与按 project/topic 的分布")
    return ap


def main(argv=None):
    ap = build_parser()
    args = ap.parse_args(argv)
    if not args.cmd:
        ap.error("需要子命令：rebuild / list / show / doc / refs / stats")

    data_root = resolve_data_root(getattr(args, "data_root", None))
    args.db_path = Path(os.path.expanduser(args.db)) if getattr(args, "db", None) \
        else data_root.joinpath(*INDEX_REL)

    if args.cmd == "rebuild":
        return cmd_rebuild(args, data_root)

    con = open_query_db(args.db_path)
    root_project = None
    if getattr(args, "root", None):
        root_path = Path(os.path.expanduser(str(args.root)))
        root_project = infer_project(root_path)
        if not root_project:
            con.close()
            fail(EXIT_USAGE, f"--root 无法推出项目名：{root_path}",
                 "查询侧 --root 只接受 <data_root>/projects/<项目>/.stand/docs 形状；"
                 "按项目过滤请改用 --project <项目名>")
    try:
        if args.cmd == "list":
            return cmd_list(con, args, root_project)
        if args.cmd == "show":
            return cmd_show(con, args, root_project)
        if args.cmd == "doc":
            return cmd_doc(con, args, root_project)
        if args.cmd == "refs":
            return cmd_refs(con, args, root_project)
        if args.cmd == "stats":
            return cmd_stats(con, args, root_project)
        con.close()
        ap.error(f"未知子命令：{args.cmd}")
    finally:
        try:
            con.close()
        except sqlite3.Error:
            pass


if __name__ == "__main__":
    sys.exit(main())
