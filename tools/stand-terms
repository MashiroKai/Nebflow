def match_documents(con, target, project=None):
    """rel 精确 > 带扩展名 > basename/去扩展名 basename > 子串。返回最高分一组。"""
    query = (target or "").strip().replace("\\", "/")
    while query.startswith("./"):
        query = query[2:]
    docs = con.execute("SELECT * FROM documents ORDER BY project, rel").fetchall()
    if project:
        docs = [d for d in docs if d["project"] == project]
    scored = []
    for doc in docs:
        rel = doc["rel"]
        base = rel.rsplit("/", 1)[-1]
        stem = base.rsplit(".", 1)[0] if "." in base else base
        score = 0
        if rel == query or rel == query + ".md" or rel == query + ".markdown":
            score = 100
        elif base == query or base == query + ".md" or stem == query:
            score = 90
        elif query and query in rel:
            score = 60
        if score:
            scored.append((score, doc))
    if not scored:
        return []
    top = max(s for s, _ in scored)
    return [doc for score, doc in scored if score == top]


