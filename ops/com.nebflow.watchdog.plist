<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.nebflow.watchdog — Tier-2 外部看门狗调度作业（2026-11-05 运维批，作者裁定「挂 launchd」）
  权威副本: stand 仓 ops/com.nebflow.watchdog.plist → live 部署位 ~/Library/LaunchAgents/com.nebflow.watchdog.plist
  安装:   cp ops/com.nebflow.watchdog.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.nebflow.watchdog.plist
  卸载:   launchctl bootout gui/$UID/com.nebflow.watchdog && rm ~/Library/LaunchAgents/com.nebflow.watchdog.plist
  观测:   launchctl print gui/$UID/com.nebflow.watchdog | egrep 'state|runs|last exit'
  日志:   脚本自写 ~/.stand/logs/watchdog.log（本作业 stdout/stderr 丢弃，与 com.nebflow.memsample 同例）

  环境变量是硬前提（脚本缺省 PORT=8080 / NF_HOME=~/.nebflow —— 那是已弃用的另一套根，
  照缺省跑会去探 8080 并调用不存在的重启脚本路径）:
    NEBFLOW_WD_PORT=6138              stand 实例端口
    NEBFLOW_WD_NF_HOME=~/.stand       stand 根（$NF_HOME/bin/nebflow-restart.sh 垫片 + $NF_HOME/logs/*）
    NEBFLOW_WD_LOG_CANDIDATES=...     失聪鉴别用的日志候选（冒号分隔，2026-11-05 运维修复批 ①）：
                                      2026-10-18 起实例实际写 logs/stand.log（`lsof -p <pid>` 实测），
                                      旧脚本硬编码 logs/nebflow.log（mtime 冻结在 10-18）⇒ DEAF 恒不命中
                                      ⇒ 「活着但 HTTP 不可达」被判 DEAD 进 Stage1（误杀）。
                                      脚本 v3 取候选里**最近 mtime 更新者**判新鲜度、全不可读则判
                                      「判据不可用」且禁判 DEAD；本键把缺省值显式钉在 plist 里，
                                      避免下次换日志路径又静默失聪（改路径 = 改这一行 + bootout/bootstrap）。
    NEBFLOW_WD_FAIL_THRESHOLD=3       **自动恢复已开启（Stage1）** —— 2026-11-05 12:29 作者裁定
                                      「只开 Stage1（推荐）」。连续 3 次健康检查失败（StartInterval=120s
                                      ⇒ 约 6 分钟发现窗，脚本缺省亦为 3：nebflow-watchdog.sh:83）才升级，
                                      且升级前先过「失聪 vs 真死」鉴别（DEAF / NOJUDGE / FOREIGN / UNKNOWN
                                      一律不动作），只有真死（DEAD）才走 Stage1 优雅重启
                                      （$NF_HOME/bin/nebflow-restart.sh = 垫片 → stand-restart.sh
                                      --restart-if-idle；四信号忙 ⇒ rc=3 零动作）。
                                      历史值 999999 = 观察态（只报不动），本批改为 3。
    NEBFLOW_WD_CLAUDE_BIN=/var/empty/claude-wd-stage2-disabled
                                      **Stage2 锁死**（同批，作者只批 Stage1，Stage2 不得开启）：
                                      脚本 Stage2 入口即 `[[ ! -x "$CLAUDE_BIN" ]] ⇒ 记一行 + exit 0`
                                      （nebflow-watchdog.sh:277-280），故把本键指到**确定不存在、
                                      且系统保证永不被创建**的绝对路径，Stage2 就只能走「不可用」分支：
                                      只记一行日志，零 spawn、零文件写（连 wd-stage2-ts 都不落）、零重启。
                                      选 /var/empty 的理由：macOS 系统空目录，root:sys 0755 且受 SIP 保护，
                                      非 root 无法在其中创建任何文件 ⇒「不存在」不是约定而是系统保证
                                      （仓内／家目录下的路径存在被后人创建的可能，故不选）。
                                      Stage2 为何尚不可开：其 PROMPT 令 agent 跑
                                      ~/.nebflow/bin/nebflow-restart.sh（该文件不存在）、诊断路径指旧根
                                      ~/.nebflow、且带 --dangerously-skip-permissions 自行 --force。
                                      要开 Stage2 须先改这三处，再把本键改回真实 claude 路径。
  StartInterval=120 取脚本自身设计节拍（nebflow-watchdog.sh 头注释「launchd 每 120s 调度」），
  不是猜的：健康探针 curl -m 10、失聪鉴别窗 600s、限速 2/h 都按该节拍推的。
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nebflow.watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/kaiyu/.stand/bin/nebflow-watchdog.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NEBFLOW_WD_PORT</key>
		<string>6138</string>
		<key>NEBFLOW_WD_NF_HOME</key>
		<string>/Users/kaiyu/.stand</string>
		<key>NEBFLOW_WD_LOG_CANDIDATES</key>
		<string>/Users/kaiyu/.stand/logs/stand.log:/Users/kaiyu/.stand/logs/nebflow.log</string>
		<key>NEBFLOW_WD_FAIL_THRESHOLD</key>
		<string>3</string>
		<key>NEBFLOW_WD_CLAUDE_BIN</key>
		<string>/var/empty/claude-wd-stage2-disabled</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>WorkingDirectory</key>
	<string>/Users/kaiyu</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
</dict>
</plist>
