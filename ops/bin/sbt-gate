#!/bin/bash
# sbt — 全局串行闸 + 默认堆帽（内存即时缓解批 M1，2026-11-04）
# 权威副本: <repo>/ops/bin/sbt-gate → 部署位: ~/.stand/bin/sbt（cp + chmod +x）
#
# 事故背景（2026-11-04 12:43 内存事故）：16GB 机器上 6 个 worktree 各自
# `sbt -Xmx3g` **无任何并发闸**，编译高峰 swap 9472/9472MB=100%、压力 4、
# load1 峰值 363——应用 JVM（已封顶 2GB）是受害者。本闸把「同时存活的 sbt 重活 JVM」
# 压到 1，并将默认堆帽从 3g 收到 1500m。
#
# 落点选择（为什么不改每个调用方）：sbt 的启动包装层 = PATH 里的 `sbt` 解析结果。
# `~/.stand/bin` 在宿主 PATH 中先于 `/opt/homebrew/bin`（实测 pid 78176 的 env），
# ⇒ 放一份 sbt 垫片即覆盖**全部**调用方（agent Bash 工具、Makefile、scripts/*.sh、
# stand-restart.sh、手工终端会话），调用方零改动。
#
# 闸语义:
#   - 同时只允许 1 个 sbt「重活」JVM（compile / test / publish …）。
#     实现: flock(2)（macOS 无 flock(1)，故经 python3 fcntl 取锁；锁挂在继承给
#     python 子进程的 fd 9 上，父 shell 持有 ⇒ 子进程退出锁不丢）。
#   - **服务形态旁路**: 命令含 run / runMain / console / reStart ⇒ 长活 JVM
#     （开发实例 / canary / 生产重启）不占重活锁，否则一次 `sbt run` 会把开发流
#     永久堵死。旁路也记账（grep 得到）。
#   - 排队可见: 等锁打 `[sbt-gate] waiting …`，拿到锁打 `[sbt-gate] acquired after Ns`。
#   - 有超时与逃生口: SBT_GATE_TIMEOUT_SECS（默认 900s，15min）到期 → 醒目告警
#     + **放行**（解除并发闸而不是锁死开发流程）；SBT_GATE=off 直接旁路。
#   - 默认堆帽 -Xmx1500m 经 SBT_OPTS 注入（sbt 启动脚本读 SBT_OPTS，见
#     /opt/homebrew/Cellar/sbt/*/libexec/bin/sbt:401/822）。用户命令里已显式给 -Xmx
#     ⇒ 尊重用户值，日志写明 override。
#
# 日志: ~/.stand/logs/sbt-gate.log（等待/获取/超时/override/旁路全记账，单行一条）
# 测试: SBT_GATE_REAL=<path> 指向假 sbt（ops/test/sbt-gate.test.sh 沙箱化自测）

set -u

GATE_LOG_DIR="${SBT_GATE_LOG_DIR:-$HOME/.stand/logs}"
GATE_LOG="${SBT_GATE_LOG:-$GATE_LOG_DIR/sbt-gate.log}"
RUN_DIR="${SBT_GATE_RUN_DIR:-$HOME/.stand/run}"
LOCK_FILE="${SBT_GATE_LOCK:-$RUN_DIR/sbt.lock}"
DEFAULT_XMX="${SBT_GATE_XMX:--Xmx1500m}"
WAIT_TIMEOUT_SECS="${SBT_GATE_TIMEOUT_SECS:-900}"   # 到期放行（不锁死开发流）
WARN_EVERY=300                                      # 等锁重复告警步长（秒）

glog() {
  printf '%s [sbt-gate] %s [pid=%s cwd=%s cmd=%s]\n' \
    "$(date '+%F %T')" "$1" "$$" "$(pwd)" "$*" >>"$GATE_LOG" 2>/dev/null
}
say() { printf '[sbt-gate] %s\n' "$*" >&2; }   # 闸自己的话走 stderr，绝不打脏 sbt stdout

# ---------- 真实 sbt 解析（跳过自身，防 exec 自环） ----------
SELF_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
resolve_real_sbt() {
  if [ -n "${SBT_GATE_REAL:-}" ] && [ -x "$SBT_GATE_REAL" ]; then printf '%s\n' "$SBT_GATE_REAL"; return 0; fi
  local IFS=':'
  for d in $PATH; do
    [ -n "$d" ] || continue
    [ -x "$d/sbt" ] || continue
    [ "$d/sbt" = "$SELF_PATH" ] && continue
    printf '%s\n' "$d/sbt"; return 0
  done
  for d in /opt/homebrew/bin/sbt /usr/local/bin/sbt /usr/bin/sbt; do
    [ -x "$d" ] && [ "$d" != "$SELF_PATH" ] && { printf '%s\n' "$d"; return 0; }
  done
  return 1
}
REAL_SBT="$(resolve_real_sbt)" || {
  echo "[sbt-gate] FATAL: no real sbt found behind the gate (SBT_GATE_REAL/PATH/homebrew)" >&2
  exit 127
}

# ---------- 逃生口 1：显式关闸 ----------
if [ "${SBT_GATE:-on}" = "off" ] || [ "${SBT_GATE:-on}" = "0" ]; then
  glog "bypass: SBT_GATE=off —— 原样 exec ${REAL_SBT} (无闸/无堆帽)"
  say "SBT_GATE=off — gate bypassed (no serialization, no heap cap)"
  exec "$REAL_SBT" "$@"
fi

# ---------- 服务形态：长活 JVM 不占重活锁 ----------
SERVICE=0
for a in "$@"; do
  case "$a" in
    run|run\ *|runMain|runMain\ *|console|console\ *|reStart|reStart\ *) SERVICE=1 ;;
  esac
done

# ---------- 默认堆帽判定 ----------
INJECT_XMX=""; HEAP_NOTE=""
for a in "$@"; do
  case "$a" in
    -Xmx*|-XX:MaxRAMPercentage=*) HEAP_NOTE="user flag $a (explicit heap wins)"; break ;;
    sbt.client.mod*|client) HEAP_NOTE="sbt-client connect mode — heap cap not injected"; break ;;
    --) break ;;
  esac
done
# SBT_OPTS 里已给 -Xmx 也算用户显式
case "${SBT_OPTS:-}" in *-Xmx*) HEAP_NOTE="SBT_OPTS already carries -Xmx (explicit wins)";; esac
[ -z "$HEAP_NOTE" ] && INJECT_XMX="$DEFAULT_XMX"

mkdir -p "$RUN_DIR" "$GATE_LOG_DIR" 2>/dev/null

apply_heap() {
  if [ -n "$INJECT_XMX" ]; then
    export SBT_OPTS="${SBT_OPTS:-} $INJECT_XMX"
    glog "heap inject SBT_OPTS+=${INJECT_XMX} (default; SBT_GATE_XMX 可调)"
    say "heap cap ${INJECT_XMX} applied via SBT_OPTS"
  else
    glog "heap inject skipped: ${HEAP_NOTE}"
    say "heap cap not injected: ${HEAP_NOTE}"
  fi
}

if [ "$SERVICE" = "1" ]; then
  glog "bypass lock: service-mode (run/console in args) —— 长活 JVM 不占重活锁"
  say "service-mode command — long-lived JVM, heavy-work lock skipped"
  apply_heap
  exec "$REAL_SBT" "$@"
fi

# ---------- 取锁：flock(2) 经 python3（macOS 无 flock(1)） ----------
HAVE_PY=0
command -v python3 >/dev/null 2>&1 && HAVE_PY=1

try_flock() {
  python3 -c '
import fcntl, sys
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(1)
sys.exit(0)
' 2>/dev/null
}

T0=$(date +%s)
LOCKED=0

if [ "$HAVE_PY" = "1" ]; then
  exec 9>>"$LOCK_FILE"
  if try_flock; then
    LOCKED=1
    glog "acquired after 0s"
  else
    say "waiting for ${LOCK_FILE} (another sbt holds the heavy-work gate; bypass: SBT_GATE=off sbt …)"
    glog "waiting for lock (timeout ${WAIT_TIMEOUT_SECS}s; escape hatch SBT_GATE=off)"
    n=0
    while :; do
      if try_flock; then LOCKED=1; glog "acquired after $(( $(date +%s) - T0 ))s"; say "acquired after $(( $(date +%s) - T0 ))s"; break; fi
      waited=$(( $(date +%s) - T0 ))
      if [ "$waited" -ge "$WAIT_TIMEOUT_SECS" ]; then
        glog "TIMEOUT: waited ${waited}s >= ${WAIT_TIMEOUT_SECS}s —— 放行（不锁死开发流，并发闸本次失效）"
        say "WARNING: waited ${waited}s (>= SBT_GATE_TIMEOUT_SECS=${WAIT_TIMEOUT_SECS}s) — proceeding WITHOUT the gate."
        say "         memory risk returns for this run; raise SBT_GATE_TIMEOUT_SECS or use SBT_GATE=off explicitly."
        break
      fi
      if [ $((waited % WARN_EVERY)) -lt 3 ] && [ "$waited" -ne "$n" ]; then
        n="$waited"
        glog "still waiting (~$((waited / 60))min) —— bypass: SBT_GATE=off sbt … / 或 kill 掉持锁 sbt"
        say "STILL waiting ~$((waited / 60))min. escape hatch: SBT_GATE=off sbt …"
      fi
      sleep 3
    done
  fi
else
  # 无 python3：mkdir 自旋锁（stale > 2h 视为残留，抢占并记账）
  LOCKD="${LOCK_FILE}.d"
  while :; do
    if mkdir "$LOCKD" 2>/dev/null; then LOCKED=1; glog "acquired after $(( $(date +%s) - T0 ))s (mkdir fallback)"; break; fi
    if [ -n "$(find "$LOCKD" -maxdepth 0 -mmin +120 2>/dev/null)" ]; then
      glog "WARN: stale mkdir lock >2h — stealing"
      rmdir "$LOCKD" 2>/dev/null; continue
    fi
    waited=$(( $(date +%s) - T0 ))
    if [ "$waited" -ge "$WAIT_TIMEOUT_SECS" ]; then
      glog "TIMEOUT: waited ${waited}s —— 放行（并发闸本次失效）"
      say "WARNING: waited ${waited}s — proceeding WITHOUT the gate (memory risk returns)"
      break
    fi
    [ $((waited % WARN_EVERY)) -lt 3 ] && say "waiting ~$((waited / 60))min for another sbt …"
    sleep 3
  done
  trap 'rmdir "$LOCKD" 2>/dev/null' EXIT
fi

[ "$LOCKED" = "1" ] && say "gate acquired after $(( $(date +%s) - T0 ))s"
apply_heap

# 锁的生命周期 = 本进程生命周期（fd 9 随之关闭）；sbt 作为子进程跑，退出码原样透传。
"$REAL_SBT" "$@"
rc=$?
if [ "$LOCKED" = "1" ]; then
  glog "release after $(( $(date +%s) - T0 ))s (rc=${rc})"
fi
exit "$rc"
