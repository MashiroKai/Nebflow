#!/bin/bash
# nebflow-restart-shim — 弃用垫片（2026-11-03 改名批；作者令 2026-10-29「这个脚本是不是也改改名为stand了」）
# nebflow 字样仅为旧名兼容，本工具属 stand（2026-11-03 作者令·双根分家批加注）。
#
# 权威副本: stand 仓 ops/bin/nebflow-restart-shim → live 部署位 ~/.stand/bin/nebflow-restart.sh
# 语义: 打印一行弃用提示后 exec 转发同目录 stand-restart.sh，参数逐字透传
#   （与 CLI 改名「老 nebflow 命令留垫片转发」同一手法）。本文件名含旧名是刻意的——
#   垫片自身就是旧名的承接面。开发实例自重启工具的正文见 ops/stand-restart.sh。
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$DIR/stand-restart.sh" ]; then
    echo "ERROR: $DIR/stand-restart.sh missing — shim cannot forward" >&2
    echo "       repair: cp <stand-repo>/ops/stand-restart.sh $DIR/stand-restart.sh && chmod +x $DIR/stand-restart.sh" >&2
    exit 66
fi
echo "nebflow-restart.sh is deprecated — use stand-restart.sh" >&2
exec "$DIR/stand-restart.sh" "$@"
