{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nebflow.dev/contracts/ptc/v1/ptc-manifest.schema.json",
  "title": "PTC v1 plugin declaration (plugin.json -> extensions.ptc)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "runtime", "tools", "profiles", "tool_servers", "limits", "workspace", "policy"],
  "properties": {
    "contract": { "const": "ptc/v1" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "min_version", "entry", "self_exec"],
      "properties": {
        "kind": { "enum": ["python", "typescript", "javascript"] },
        "min_version": { "type": "string" },
        "entry": { "type": "string", "description": "Path (relative to the plugin root) of the executor script/entry." },
        "self_exec": { "type": "boolean", "description": "true = tool server command ${RUNTIME_SELF} resolves to the executor's own interpreter." }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "profile"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "profile": { "enum": ["readonly", "readwrite"] },
          "description": { "type": "string" }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["readonly", "readwrite"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tools"],
        "properties": {
          "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "tool_servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transport", "command", "args"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "transport": { "enum": ["stdio"] },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "timeout_ms": { "type": "integer", "minimum": 100 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_timeout_ms", "max_timeout_ms", "max_tool_calls", "max_output_bytes", "max_memory_mb", "max_cpu_ms"],
      "properties": {
        "default_timeout_ms": { "type": "integer", "minimum": 100 },
        "max_timeout_ms": { "type": "integer", "minimum": 100 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1024 },
        "max_memory_mb": { "type": "integer", "minimum": 32 },
        "max_cpu_ms": { "type": "integer", "minimum": 100 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_cwd", "fs_roots"],
      "properties": {
        "default_cwd": { "type": "string" },
        "fs_roots": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "subprocess", "fs_write", "env"],
      "properties": {
        "network": { "enum": ["deny"] },
        "subprocess": { "enum": ["deny"] },
        "fs_write": { "enum": ["profile", "deny"] },
        "env": { "enum": ["scrubbed"] }
      }
    }
  }
}
