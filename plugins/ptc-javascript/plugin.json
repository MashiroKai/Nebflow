{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ptc-javascript",
  "version": "1.0.0",
  "description": "PTC 模式 JavaScript 承载件——节点获得 ptc_run / ptc_run_rw：模型写 JavaScript 代码（ES2022，**无类型转译**——TS 注解会 PTC_SYNTAX）编排工具调用（node 权限模型限定 fs + 网络面 patch），tools.* 经执行器以 MCP client 转调宿主工具 server（标准 MCP）。返回 stdout、完成值、逐次调用台账、四类错误分类；写能力仅 ptc_run_rw 给。用于 ≥2 次工具调用的循环/分支编排，不适用于单次工具调用与无工具任务的问答。前置 node≥20。内含 skills：ptc-javascript（请求面、绑定形状、错误判读、排障）。",
  "author": {
    "name": "Stand"
  },
  "keywords": [
    "ptc",
    "programmatic-tool-calling",
    "code-orchestration",
    "javascript",
    "node",
    "mcp",
    "sandbox"
  ],
  "extensions": {
    "ptc": {
      "contract": "ptc/v1",
      "runtime": {
        "kind": "javascript",
        "min_version": "20.0.0",
        "entry": "skills/ptc-javascript/dist/ptc_executor.js",
        "self_exec": true
      },
      "tools": [
        {
          "name": "ptc_run",
          "profile": "readonly",
          "description": "Execute JavaScript code that orchestrates read-only host tool calls (read/glob/grep/stat)."
        },
        {
          "name": "ptc_run_rw",
          "profile": "readwrite",
          "description": "Execute JavaScript code that orchestrates host tool calls including write/edit/remove."
        }
      ],
      "profiles": {
        "readonly": {
          "tools": [
            "read",
            "glob",
            "grep",
            "stat"
          ]
        },
        "readwrite": {
          "tools": [
            "read",
            "glob",
            "grep",
            "stat",
            "write",
            "edit",
            "remove"
          ]
        }
      },
      "tool_servers": [
        {
          "id": "fs",
          "transport": "stdio",
          "command": "${RUNTIME_SELF}",
          "args": [
            "${PLUGIN_ROOT}/skills/ptc-javascript/dist/ptc_tools_fs.js"
          ],
          "timeout_ms": 10000
        }
      ],
      "limits": {
        "default_timeout_ms": 30000,
        "max_timeout_ms": 300000,
        "max_tool_calls": 64,
        "max_output_bytes": 65536,
        "max_memory_mb": 1024,
        "max_cpu_ms": 60000
      },
      "workspace": {
        "default_cwd": "${PLUGIN_DATA}/workspace",
        "fs_roots": [
          "${PLUGIN_DATA}/workspace"
        ]
      },
      "policy": {
        "network": "deny",
        "subprocess": "deny",
        "fs_write": "profile",
        "env": "scrubbed"
      }
    }
  }
}
