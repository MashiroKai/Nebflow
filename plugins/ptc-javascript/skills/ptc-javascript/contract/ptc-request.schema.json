{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nebflow.dev/contracts/ptc/v1/ptc-request.schema.json",
  "title": "PTC v1 execution request (arguments of the ptc_run / ptc_run_rw MCP tool)",
  "type": "object",
  "additionalProperties": false,
  "required": ["code"],
  "properties": {
    "contract": { "const": "ptc/v1" },
    "language": { "enum": ["python", "typescript", "javascript"] },
    "code": { "type": "string", "minLength": 1, "maxLength": 262144 },
    "profile": { "enum": ["readonly", "readwrite"], "default": "readonly" },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "uniqueItems": true,
      "description": "Must be a subset of the profile ceiling declared in the plugin manifest; the executor intersects, it never widens."
    },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 3600000 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1024 },
        "max_memory_mb": { "type": "integer", "minimum": 32 },
        "max_cpu_ms": { "type": "integer", "minimum": 100 }
      }
    },
    "cwd": { "type": "string", "description": "Absolute path; must resolve inside fs_roots." },
    "fs_roots": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Must be a subset of the manifest workspace.fs_roots."
    },
    "args": {
      "type": "object",
      "description": "Opaque parameter bag bound to `ptc.args` in the generated code."
    },
    "exec_id": { "type": "string", "maxLength": 128, "description": "Host-minted opaque id, echoed back in the response." }
  }
}
