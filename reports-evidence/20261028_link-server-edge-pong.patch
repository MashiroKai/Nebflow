     for field in fields {
         let (k, v) = field
             .split_once('=')
@@ -2802,3 +2808,28 @@ fn q5_transport_defaults_are_64mib_message_16mib_frame() {
     assert_eq!(cfg.max_message_size, Some(64 << 20), "64 MiB message cap");
     assert_eq!(cfg.max_frame_size, Some(16 << 20), "16 MiB frame cap");
 }
+
+// ── console-reconnect-stability (2026-10-28): edge heartbeat pong ──────────
+
+/// 边缘 pong 判定钉：只认「小帧 + JSON type=="ping"」。
+/// - 精确 ping 帧 = true；
+/// - 同长度其他 type / 用户输入 / 大帧 = false（不解析大帧、不误判语义）。
+#[test]
+fn edge_pong_ping_detector_is_exact_and_cheap() {
+    assert!(crate::portal_ingress::is_console_heartbeat_ping(r#"{"type":"ping"}"#));
+    assert!(!crate::portal_ingress::is_console_heartbeat_ping(
+        r#"{"type":"pong"}"#
+    ));
+    assert!(!crate::portal_ingress::is_console_heartbeat_ping(
+        r#"{"type":"textDelta","delta":"x"}"#
+    ));
+    // 用户输入里含 "ping"/"type" 字样但 type 非 ping。
+    assert!(!crate::portal_ingress::is_console_heartbeat_ping(
+        r#"{"content":"{\"type\":\"ping\"}"}"#
+    ));
+    // 大帧（>64B）一律不判定为心跳（避免为识别而解析大帧）。
+    let big = format!(r#"{{"type":"ping","pad":"{}"}}"#, "x".repeat(64));
+    assert!(!crate::portal_ingress::is_console_heartbeat_ping(&big));
+    // 非法 JSON = false。
+    assert!(!crate::portal_ingress::is_console_heartbeat_ping("ping"));
+}
