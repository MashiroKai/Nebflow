         "t1_body_frames={} t1_body_bytes={} t1_bp_drops={} t1_http_cycles={} t1_ws_cycles={} \
          t2_upgrades={} t2_offline_notices={} t2_browser_closes={} t2_hdr_timeouts={} \
          t2_body_timeouts={} t2_ws_timeouts={} t2_seq_drops={} migration_dropped={} \
-         runtime_rejects={} wrong_direction={} ws_data_dropped={}",
+         runtime_rejects={} wrong_direction={} ws_data_dropped={} edge_pongs={}",
         T1_BODY_FRAMES_TOTAL.load(Ordering::Relaxed),
         T1_BODY_BYTES_TOTAL.load(Ordering::Relaxed),
         T1_BACKPRESSURE_DROPS_TOTAL.load(Ordering::Relaxed),
@@ -139,6 +185,7 @@ pub fn portal_metrics_summary() -> String {
         RUNTIME_REJECTS_TOTAL.load(Ordering::Relaxed),
         WRONG_DIRECTION_DROPS_TOTAL.load(Ordering::Relaxed),
         WS_DATA_FRAME_DROPPED_TOTAL.load(Ordering::Relaxed),
+        T2_EDGE_PONGS_TOTAL.load(Ordering::Relaxed),
     )
 }
 
