 pub const HOST_OFFLINE_CLOSE_CODE: u16 = 1011;
 pub const HOST_OFFLINE_CLOSE_REASON: &str = "host relay link gone";
 
+// ── console-reconnect-stability (2026-10-28): edge heartbeat pong ──────────
+//
+// 病灶：浏览器控制台 30s 应用层 ping 的 pong 此前必须完整走
+// 「host 引擎出站 FIFO → relay 上行队列 → relay socket → 本进程下行队列 →
+// 浏览器」全链。任一环被大帧阵发（historyPage / 大 toolResult / 文件字节）
+// 压住，pong 就迟到；前端连续 3 次 miss 即自我逐出，顶栏「连接断开 · 正在
+// 重连」。host 侧 2026-10-28 生产读数：relay 上行 inbox full 当日 3,967 回合
+// （16 点档 2,190），全程 console 出站 overflowDrops/overflowCloses=0 ——
+// 即饥饿不在容量溢出，而在 FIFO 排队。
+//
+// 修法 = ping 在入口**就地应答** pong，同时**照常转发** host：
+//   · host 的 console 僵尸判死（90s 无入站帧回收）依赖的入站活跃钟不变
+//     （ping 仍到 host），host 产生的那份 pong 稍后到达只是冗余帧，
+//     前端按 type=="pong" 清 pendingPong，重复 pong 零副作用；
+//   · 不掩盖真断链：host relay 断开仍走既有 HOST_OFFLINE_CLOSE_CODE 1011
+//     传播 + ws_idle 90s 看门狗；本件只消除「活着但排队」的假死。
+// 止损开关：`PORTAL_EDGE_PONG=0|false|off` 即回到修前逐字行为（只转发）。
+
+/// 控制台心跳 ping 判定：小帧 + JSON type=="ping"（ws.js `sendWs({type:'ping'})`
+/// 产物）。>64B 一律不算（用户输入/大帧绝不误判，也避免为识别而解析大帧）。
+pub fn is_console_heartbeat_ping(text: &str) -> bool {
+    if text.len() > 64 {
+        return false;
+    }
+    serde_json::from_str::<serde_json::Value>(text)
+        .ok()
+        .and_then(|v| v.get("type").and_then(|t| t.as_str()).map(|s| s == "ping"))
+        .unwrap_or(false)
+}
+
+/// 边缘应答开关（默认开）。每次浏览器 WS 升级读一次，运行期改 env 不影响
+/// 已建立的会话。
+pub fn edge_pong_enabled() -> bool {
+    std::env::var("PORTAL_EDGE_PONG")
+        .map(|v| {
+            let v = v.trim().to_ascii_lowercase();
+            !(v == "0" || v == "false" || v == "off")
+        })
+        .unwrap_or(true)
+}
+
+/// 边缘就地应答的 pong 计数（只增读数；A/B 对照：开启后该计数 >0 且
+/// T2_WS_IDLE_TIMEOUTS_TOTAL 不升、前端重连频次下降即为生效证据）。
+pub static T2_EDGE_PONGS_TOTAL: AtomicU64 = AtomicU64::new(0);
+
+
 // ────────────────────────── T-1/T-2 counters ──────────────────────────
 
 /// T-1: body_frame chunks carried (both directions).
