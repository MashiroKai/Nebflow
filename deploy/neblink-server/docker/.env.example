# NebLink Server deployment configuration.
# Copy this file to `.env` and fill in the values, then: docker compose up -d --build

# JWT signing secret for access tokens + cookie signing.
# Generate with:  openssl rand -hex 32
NEBFLOW_JWT_SECRET=

# GitHub OAuth App credentials.
# Create at: https://github.com/settings/developers (OAuth Apps → New OAuth App)
#   - Homepage URL: https://neblink.nebflow.space
#   - Authorization callback URL: https://neblink.nebflow.space/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The callback URL the browser returns to after GitHub authorizes. Must EXACTLY
# match the callback URL configured in the GitHub OAuth App.
OAUTH_REDIRECT_URL=https://neblink.nebflow.space/api/auth/github/callback

# Public base URL of the deployment (where the SPA is served). Used to redirect
# the browser back after OAuth callback.
APP_PUBLIC_URL=https://neblink.nebflow.space

# Log level: error, warn, info (default), debug, trace
RUST_LOG=info
